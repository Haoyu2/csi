# Model artifacts
*.h5
*.mat

# Python
__pycache__/
*.pyc

# OS / IDE
.DS_Store
.idea/
.vs/
.ipynb_checkpoints/

# Training runs (generated)
# Track exp_* sweep outputs (committed experiment records);
# ignore ad-hoc per-experiment train.py runs and the runs_archive.
runs/*
!runs/exp_*/
runs_archive/

# Array cache written by dataset.load_arrays — large, regenerable
cache/

# Generated analysis figures / reports
# Track analysis/dataset/ (committed corpus distribution PNGs);
# ignore everything else under analysis/.
analysis/*
!analysis/dataset/

# Datasets (raw + reorganized) and archives
# Track data/ itself (via .gitkeep) so the directory ships in the repo,
# but ignore the BVP files extracted into it by extract_data.py.
data/*
!data/.gitkeep
data_raw/
data-old/
*.zip

# Dataset manifests pulled from main
bvp_full.csv
statistic.txt
